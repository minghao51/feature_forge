{
  "$defs": {
    "Layer": {
      "description": "Durable maturity layer for an experiment artifact.",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "title": "Layer",
      "type": "string"
    },
    "ManifestRef": {
      "additionalProperties": false,
      "description": "Reference to a committed layer manifest.",
      "properties": {
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "relative_path": {
          "const": "manifest.json",
          "default": "manifest.json",
          "title": "Relative Path",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "layer",
        "run_id",
        "sha256"
      ],
      "title": "ManifestRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_fingerprint": {
      "minLength": 1,
      "title": "Case Fingerprint",
      "type": "string"
    },
    "generated_contract_version": {
      "default": "1",
      "title": "Generated Contract Version",
      "type": "string"
    },
    "gold_input_fingerprint": {
      "minLength": 1,
      "title": "Gold Input Fingerprint",
      "type": "string"
    },
    "method_config": {
      "additionalProperties": true,
      "title": "Method Config",
      "type": "object"
    },
    "method_name": {
      "minLength": 1,
      "title": "Method Name",
      "type": "string"
    },
    "method_version": {
      "minLength": 1,
      "title": "Method Version",
      "type": "string"
    },
    "persist_candidates": {
      "default": true,
      "title": "Persist Candidates",
      "type": "boolean"
    },
    "prompt_bundle_fingerprint": {
      "minLength": 1,
      "title": "Prompt Bundle Fingerprint",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_policy": {
      "additionalProperties": true,
      "title": "Selection Policy",
      "type": "object"
    },
    "silver_fingerprint": {
      "minLength": 1,
      "title": "Silver Fingerprint",
      "type": "string"
    },
    "silver_manifest": {
      "$ref": "#/$defs/ManifestRef"
    },
    "value_atol": {
      "default": 1e-12,
      "minimum": 0,
      "title": "Value Atol",
      "type": "number"
    },
    "value_rtol": {
      "default": 1e-09,
      "minimum": 0,
      "title": "Value Rtol",
      "type": "number"
    }
  },
  "required": [
    "run_id",
    "case_fingerprint",
    "silver_manifest",
    "silver_fingerprint",
    "gold_input_fingerprint",
    "method_name",
    "method_version",
    "prompt_bundle_fingerprint"
  ],
  "title": "GoldRequest",
  "type": "object"
}
