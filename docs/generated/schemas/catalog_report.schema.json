{
  "$defs": {
    "CatalogIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "CatalogIssue",
      "type": "object"
    },
    "VerificationStatus": {
      "enum": [
        "valid",
        "invalid",
        "missing",
        "incompatible",
        "operational_error"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog_schema_version": {
      "default": 1,
      "title": "Catalog Schema Version",
      "type": "integer"
    },
    "indexed_manifests": {
      "default": 0,
      "minimum": 0,
      "title": "Indexed Manifests",
      "type": "integer"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/CatalogIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "logical_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logical Digest"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/VerificationStatus"
    }
  },
  "required": [
    "status"
  ],
  "title": "CatalogReport",
  "type": "object"
}
