{
  "$defs": {
    "Layer": {
      "description": "Durable maturity layer for an experiment artifact.",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "title": "Layer",
      "type": "string"
    },
    "ManifestRef": {
      "additionalProperties": false,
      "description": "Reference to a committed layer manifest.",
      "properties": {
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "relative_path": {
          "const": "manifest.json",
          "default": "manifest.json",
          "title": "Relative Path",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "layer",
        "run_id",
        "sha256"
      ],
      "title": "ManifestRef",
      "type": "object"
    },
    "RunState": {
      "description": "Lifecycle state of a run or stage.",
      "enum": [
        "planned",
        "running",
        "partial",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunState",
      "type": "string"
    },
    "StageDisposition": {
      "description": "How a stage contributed to the current run.",
      "enum": [
        "executed",
        "reused",
        "skipped"
      ],
      "title": "StageDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Verified decision for one layer in dependency order.",
  "properties": {
    "disposition": {
      "$ref": "#/$defs/StageDisposition"
    },
    "expected_fingerprint": {
      "minLength": 1,
      "title": "Expected Fingerprint",
      "type": "string"
    },
    "layer": {
      "$ref": "#/$defs/Layer"
    },
    "manifest_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ManifestRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "layer",
    "expected_fingerprint",
    "disposition",
    "reason"
  ],
  "title": "ResumeStageDecision",
  "type": "object"
}
