{
  "$defs": {
    "FailureClass": {
      "description": "Failure category used to decide whether recovery is safe.",
      "enum": [
        "transient",
        "deterministic",
        "policy",
        "resource",
        "cancelled"
      ],
      "title": "FailureClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Serializable failure context shared by sequential and process execution.",
  "properties": {
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "cause_types": {
      "items": {
        "type": "string"
      },
      "title": "Cause Types",
      "type": "array"
    },
    "error_type": {
      "minLength": 1,
      "title": "Error Type",
      "type": "string"
    },
    "failure_class": {
      "$ref": "#/$defs/FailureClass"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "default": "case",
      "title": "Stage",
      "type": "string"
    }
  },
  "required": [
    "failure_class",
    "error_type",
    "message"
  ],
  "title": "FailureRecord",
  "type": "object"
}
