{
  "$defs": {
    "ArtifactDescriptor": {
      "additionalProperties": false,
      "description": "Hash and schema metadata for one file in a durable package.",
      "properties": {
        "column_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Count"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "row_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        },
        "schema_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Fingerprint"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "layer",
        "media_type",
        "relative_path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactDescriptor",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "description": "Result of one required or advisory validation check.",
      "properties": {
        "affected_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Affected Artifacts",
          "type": "array"
        },
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "expected": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/CheckSeverity",
          "default": "error"
        }
      },
      "required": [
        "check_id",
        "passed",
        "message"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "CheckSeverity": {
      "description": "Severity used to distinguish advisory and required checks.",
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "CheckSeverity",
      "type": "string"
    },
    "FailureClass": {
      "description": "Failure category used to decide whether recovery is safe.",
      "enum": [
        "transient",
        "deterministic",
        "policy",
        "resource",
        "cancelled"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "Layer": {
      "description": "Durable maturity layer for an experiment artifact.",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "title": "Layer",
      "type": "string"
    },
    "RunState": {
      "description": "Lifecycle state of a run or stage.",
      "enum": [
        "planned",
        "running",
        "partial",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Persisted outcome for one executable stage.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactDescriptor"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "duration_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "error_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    },
    "failure_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "skipped_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skipped Reason"
    },
    "stage": {
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    }
  },
  "required": [
    "stage",
    "state",
    "started_at"
  ],
  "title": "StageResult",
  "type": "object"
}
